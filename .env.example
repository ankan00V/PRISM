# PRISM Environment Configuration Example
# Copy this file to .env and fill in the secret keys.

# Nvidia NIM API Key (required for live RAG routing and response synthesis)
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here

# Port to host the Express backend server
PORT=5000

# Node Environment Mode (development or production)
NODE_ENV=development

# Offline Fallback Mode: set to true to force rule-based offline answer synthesis without contacting Nvidia API
OFFLINE_MODE=false
